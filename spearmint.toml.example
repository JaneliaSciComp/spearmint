# spearmint per-project config. Copy to `spearmint.toml` at your repo root (or paste these keys
# under a [tool.spearmint] table in your pyproject.toml) and edit. Every key is optional; unset
# keys fall back to the built-in default shown. Any key can also be overridden by an env var
# SPEARMINT_<KEY> (e.g. SPEARMINT_GPU_QUEUE=gpu_h100), which wins over the file.

# --- LSF cluster (Janelia; GPU queue preference b300 > h200 > h100 > a100 > l4) ---
# lsf_project = "miaai"
# gpu_queue   = "gpu_b300"
# gpu_slots   = 12
# cpu_queue   = "local"

# --- run outputs ---
# root = ""   # where run outputs live; empty -> $SPEARMINT_ROOT env, else <repo root>/output_rundb

# --- dashboard ---
# port            = 8766
# refresh_seconds = 10

# --- dagrunner ---
# max_parallel = 32
